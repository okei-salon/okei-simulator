rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bump ONLY when hubData schema changes.
    // Keep in sync with assets/hub-app-version.json and assets/js/hub-app-version.js
    function requiredSchemaVersion() {
      return 2;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidSchemaVersion() {
      // Client SDK stores whole numbers as float; accept number equality.
      return request.resource.data.keys().hasAny(['schemaVersion'])
        && request.resource.data.schemaVersion is number
        && request.resource.data.schemaVersion == requiredSchemaVersion();
    }

    // hubData writes require matching schemaVersion so stale cached JS cannot overwrite.
    // Also honor control/writeGate.suspended (cross-client maintenance lock).
    function writeGateSuspended(userId) {
      let gatePath = /databases/$(database)/documents/users/$(userId)/control/writeGate;
      return exists(gatePath)
        && get(gatePath).data.suspended == true
        && (
          !('expiresAt' in get(gatePath).data)
          || !(get(gatePath).data.expiresAt is number)
          || get(gatePath).data.expiresAt == 0
          || get(gatePath).data.expiresAt > request.time.toMillis()
        );
    }

    match /users/{userId}/hubData/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && hasValidSchemaVersion() && !writeGateSuspended(userId);
      allow delete: if isOwner(userId) && !writeGateSuspended(userId);
    }

    // Other user docs (e.g. profile) — no schemaVersion gate.
    match /users/{userId}/profile/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Cross-client write gate / maintenance control.
    match /users/{userId}/control/{docId} {
      allow read, write: if isOwner(userId);
    }

  }
}
